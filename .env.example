# ---------------------------------------------------------------------------
# DealFinder environment. Copy to .env and fill in. Never commit .env.
# Every variable is documented. Leave blank to use the mock implementation.
# ---------------------------------------------------------------------------

# --- Core ---------------------------------------------------------------
APP_ENV=dev                       # dev | prod | test
MOCK_MODE=true                    # true = run with mock eBay/Claude/notifier/sold data (no keys needed)
SECRET_KEY=change-me              # used for session signing in the dashboard
LOG_LEVEL=INFO
TZ=Europe/London

# --- Database ------------------------------------------------------------
# SQLite for a quick local start; Postgres in docker compose.
DATABASE_URL=sqlite:///./data/dealfinder.db
# DATABASE_URL=postgresql+psycopg2://dealfinder:dealfinder@db:5432/dealfinder

# --- Claude API (Module 2 normalisation/risk, Module 5 listing copy, Module 6 insights)
ANTHROPIC_API_KEY=                # blank = MockLLMClient (rule-based)
CLAUDE_MODEL=claude-opus-5-5      # any current Claude model id

# --- eBay (Module 1 Browse API, Module 2 Marketplace Insights, Module 5 Sell APIs)
EBAY_CLIENT_ID=                   # App ID from developer.ebay.com (production keyset)
EBAY_CLIENT_SECRET=               # Cert ID
EBAY_MARKETPLACE_ID=EBAY_GB
EBAY_ENV=production               # production | sandbox
EBAY_SELL_OAUTH_TOKEN=            # user token for Sell Inventory/Offer/Fulfilment (optional until you list)
EBAY_MARKETPLACE_INSIGHTS_ENABLED=false  # set true once eBay grants sold-data access

# --- Notifications (Module 4) -------------------------------------------
NOTIFIER=mock                     # ntfy | pushover | mock
NTFY_SERVER=https://ntfy.sh       # or http://ntfy:80 for the bundled self-hosted server
NTFY_TOPIC=                       # a long random topic name, e.g. dealfinder-7f3a9c2e
NTFY_TOKEN=                       # optional access token for a protected topic
PUSHOVER_USER_KEY=
PUSHOVER_APP_TOKEN=
DASHBOARD_BASE_URL=http://localhost:8000   # used for deal links inside notifications

# --- Browser helper (Module 1) ------------------------------------------
BROWSER_PROFILE_DIR=./data/browser_profile  # persistent Chromium profile you log into once
BROWSER_HEADLESS=true             # false to watch it work / log in
BROWSER_SOURCES_ENABLED=false     # true once you've logged in to the marketplaces
BROWSER_MIN_DELAY_S=45
BROWSER_MAX_DELAY_S=120
BROWSER_MAX_PAGE_LOADS_PER_HOUR=40
BROWSER_QUIET_HOURS=23-07         # local time, no browsing between these hours

# --- Scheduler -------------------------------------------------------------
SCHEDULER_ENABLED=true            # false to run the web app only
SOURCE_POLL_INTERVAL_MIN=15       # default poll interval per source
DIGEST_INTERVAL_MIN=30
DAILY_SUMMARY_HOUR=8

# --- Retention -------------------------------------------------------------
PASSED_DEAL_RETENTION_DAYS=90     # auto-purge personal data from passed deals after this
